# Copie para .env e ajuste. NUNCA coloque senhas de corretora aqui.

# Rede: por padrão só aceita conexões do próprio computador.
HOST=127.0.0.1
PORT=4100

# PostgreSQL. Sem DATABASE_URL o servidor roda em memória (nada persiste).
DATABASE_URL=postgres://blackwolf:TROQUE_ESTA_SENHA@127.0.0.1:5432/blackwolf_floor

# Usuário do painel. A senha é definida com:  npm run user:set-password -- --user admin
# (fica salva apenas como hash scrypt no banco).
BW_ADMIN_USER=admin

# Duração da sessão do navegador (horas)
SESSION_TTL_HOURS=12

# Acesso pela rede local (outro PC/tablet): exige TLS.
# Gere um certificado (ex.: mkcert) e aponte os arquivos abaixo, depois HOST=0.0.0.0
# TLS_CERT=./certs/floor.pem
# TLS_KEY=./certs/floor-key.pem

# Origens extras permitidas para o navegador (separadas por vírgula)
# ALLOWED_ORIGINS=https://192.168.0.10:4100

# Usado só pelo docker-compose.yml (Postgres em container)
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
